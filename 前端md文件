```tsx
// ApprovalModal.tsx
import { Modal, Form, Input, Radio, Space, Alert, Divider } from 'antd';

const ApprovalModal = ({ visible, requestData, onSubmit, onCancel }) => {
  const [form] = Form.useForm();
  const [action, setAction] = useState<'approve' | 'reject'>('approve');

  return (
    <Modal
      title={
        <Space>
          <FileProtectOutlined />
          <span>审批变更申请</span>
        </Space>
      }
      open={visible}
      width={800}
      onOk={() => {
        form.validateFields().then(values => {
          onSubmit({ ...values, action });
        });
      }}
      onCancel={onCancel}
      okText={action === 'approve' ? '同意' : '驳回'}
      okButtonProps={{
        danger: action === 'reject',
        type: action === 'approve' ? 'primary' : 'default'
      }}
    >
      <Form form={form} layout="vertical">
        {/* 变更申请概要 */}
        <Alert
          message={
            <Space direction="vertical" size={4}>
              <div>
                <Tag color="blue">{requestData.requestId}</Tag>
                <span>{requestData.catalogName}</span>
              </div>
              <div style={{ fontSize: 12, color: '#595959' }}>
                发起人：{requestData.submitter.name} |
                提交时间：{requestData.submitTime}
              </div>
            </Space>
          }
          type="info"
          showIcon
          style={{ marginBottom: 16 }}
        />

        {/* 变更内容概要 */}
        <Card size="small" style={{ marginBottom: 16 }}>
          <Typography.Text type="secondary">变更内容：</Typography.Text>
          <Space size={4} style={{ marginTop: 8 }}>
            {requestData.addCount > 0 && (
              <Tag color="success">新增 {requestData.addCount} 个E4体验项</Tag>
            )}
            {requestData.modifyCount > 0 && (
              <Tag color="orange">修改 {requestData.modifyCount} 个E4体验项</Tag>
            )}
          </Space>
          <Divider style={{ margin: '12px 0' }} />
          <Typography.Text type="secondary">变更理由：</Typography.Text>
          <div style={{ marginTop: 8 }}>{requestData.changeReason}</div>
          <Button
            type="link"
            size="small"
            style={{ padding: 0, marginTop: 8 }}
            onClick={() => handleViewFullDetail(requestData.requestId)}
          >
            查看完整变更详情 →
          </Button>
        </Card>

        {/* 审批决定 */}
        <Form.Item
          label="审批决定"
          name="action"
          initialValue="approve"
          rules={[{ required: true }]}
        >
          <Radio.Group onChange={(e) => setAction(e.target.value)}>
            <Radio.Button value="approve">
              <CheckOutlined /> 同意
            </Radio.Button>
            <Radio.Button value="reject">
              <CloseOutlined /> 驳回
            </Radio.Button>
          </Radio.Group>
        </Form.Item>

        {/* 审批意见 */}
        <Form.Item
          label={action === 'approve' ? '审批意见（选填）' : '驳回理由（必填）'}
          name="opinion"
          rules={[
            {
              required: action === 'reject',
              message: '请填写驳回理由'
            }
          ]}
        >
          <Input.TextArea
            placeholder={
              action === 'approve'
                ? '例如：变更合理，补充了低温场景的体验描述。'
                : '例如：新增的低温环境适配描述与现有"极端环境适配"存在重叠...'
            }
            autoSize={{ minRows: 4, maxRows: 8 }}
            maxLength={500}
            showCount
          />
        </Form.Item>

        {action === 'reject' && (
          <Alert
            message="温馨提示"
            description="驳回后，发起人可以修改变更内容并重新提交审批。"
            type="warning"
            showIcon
            closable
          />
        )}
      </Form>
    </Modal>
  );
};
